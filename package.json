{
  "name": "held-alive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bridge": "tsx bridge/index.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:integration": "node scripts/test-integration.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:browser": "node scripts/test-browser-inference.mjs",
    "setup": "node scripts/setup-local.mjs",
    "install:bridge": "node scripts/install-bridge.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
